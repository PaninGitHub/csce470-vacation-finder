# Copy to .env.local for development (or set in the Vercel dashboard for production).
# Base URL of the API, no trailing slash. Defaults to http://localhost:8000 if unset.
VITE_API_URL=https://api.example.com

# Dev only: use BM25 so the backend skips loading the embedding model.
# Do NOT set this on the deployed app; it must use the backend default (Hybrid).
# VITE_RANKER=BM25
